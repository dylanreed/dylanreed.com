{# ABOUTME: Reusable book card component for featured works. #}
{# ABOUTME: Displays cover (real or placeholder), genre tag, hook, and status. #}

<div class="book-card book-card-with-cover">
  <a href="/books/{{ book.slug }}/">
    {% if book.coverImage %}
      <img src="{{ book.coverImage }}" alt="{{ book.title }} cover" class="book-card-cover">
    {% else %}
      <div class="book-card-cover book-card-placeholder" style="background-color: {{ book.genre | genreColor }}">
        <span class="placeholder-title">{{ book.title }}</span>
        <span class="placeholder-author">Dylan Reed</span>
      </div>
    {% endif %}
    <div class="book-card-text">
      <span class="genre-tag" style="background-color: {{ book.genre | genreColor }}">{{ book.genre }}</span>
      <h3>{{ book.title }}</h3>
      <p class="hook">{{ book.hook }}</p>
      {% if book.freeWithNewsletter %}
        <p class="status free-badge">free with newsletter signup</p>
      {% else %}
        <p class="status">{{ book.status | statusLabel }}</p>
      {% endif %}
    </div>
  </a>
</div>
