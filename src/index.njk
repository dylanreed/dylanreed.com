---
layout: layouts/base.njk
title: ""
---

{# ABOUTME: Home page — hero with taped-in photo, featured works, blog feed, newsletter. #}
{# ABOUTME: First impression for readers and industry professionals. #}

<section class="hero">
  <div class="hero-photo">
    <span class="margin-note hero-margin-note">fiction writer, previously: clown</span>
    <div class="taped-photo">
      <img src="/assets/images/dylan.jpeg" alt="Dylan Reed — fiction writer" width="240" height="240">
    </div>
  </div>
  <div class="hero-text">
    <h1>Dylan Reed</h1>
    <p class="hero-intro">I write speculative fiction about systems that fail the people inside them — dragon licensing boards, dying deep-sea stations, cozy towns where slime runs the bakery.</p>
    <div>
      <a href="/books/" class="hero-cta">See the books</a>
      <a href="/about/" class="hero-cta-secondary">or read about me →</a>
    </div>
  </div>
</section>

<section class="free-story-callout">
  <div class="free-story-inner">
    {%- for book in books -%}
      {%- if book.freeWithNewsletter -%}
        {% if book.coverImage %}
          <img src="{{ book.coverImage }}" alt="{{ book.title }} cover" class="free-story-cover">
        {% endif %}
        <div class="free-story-text">
          <h2>Read something right now</h2>
          <p><strong>{{ book.title }}</strong> — {{ book.hook }}</p>
          <p class="margin-note" style="position: static; width: auto; text-align: left;">Sign up for <em>The Margin Notes</em> and it's yours. Free.</p>
          <form
            action="https://buttondown.com/api/emails/embed-subscribe/dylannotdylan"
            method="post"
            class="newsletter-form"
          >
            <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address">
            <button type="submit">Get the story</button>
          </form>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section>
  <h2 class="section-header">Featured Works</h2>
  <div class="book-cards">
    {%- for book in books -%}
      {%- if book.featured and not book.freeWithNewsletter -%}
        {% include "partials/book-card.njk" %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<section>
  <h2 class="section-header">From the Blog</h2>
  {% set feedLimit = 5 %}
  {% include "partials/blog-feed.njk" %}
  <p><a href="/blog/">See all posts →</a></p>
</section>

{% include "partials/newsletter.njk" %}
